[Unit]
Description=goesrecv signal-lock monitor
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/goesrecv-lock-monitor
ExecStart=/usr/bin/python3 /opt/goesrecv-lock-monitor/goesrecv_lock_monitor.py --config /etc/goesrecv-lock-monitor/config.json
EnvironmentFile=-/etc/goesrecv-lock-monitor/environment
Restart=on-failure
RestartSec=5
User=goesrecv-monitor
Group=goesrecv-monitor
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
