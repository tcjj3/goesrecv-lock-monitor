    "goesrecv": {
        "host": "127.0.0.1",
        "decoder_port": 6002,
        "socket_timeout_seconds": 10.0,
        "reconnect_delay_seconds": 2.0,
    },
    "lock": {
        "loss_confirm_seconds": 5.0,
        "recovery_confirm_seconds": 5.0,
